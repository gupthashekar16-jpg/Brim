<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Brim</AssemblyName>
    <RootNamespace>Brim</RootNamespace>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CA1416;WFO5001;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- brim-hook.exe: the tiny relay that AI agents call; shipped next to Brim.exe -->
  <ItemGroup>
    <ProjectReference Include="..\BrimHook\BrimHook.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyBrimHook" AfterTargets="Build">
    <ItemGroup>
      <BrimHookFiles Include="..\BrimHook\bin\$(Configuration)\net10.0\brim-hook.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrimHookFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBrimHook" AfterTargets="Publish">
    <ItemGroup>
      <BrimHookPublish Include="..\BrimHook\bin\$(Configuration)\net10.0\brim-hook.*" Exclude="..\BrimHook\bin\$(Configuration)\net10.0\brim-hook.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BrimHookPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
